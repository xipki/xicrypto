<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xipki.crypto</groupId>
    <artifactId>xicrypto</artifactId>
    <version>7.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>crypto-be-bc-fips</artifactId>
  <name>XiPKI :: ${project.artifactId}</name>
  <dependencies>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bc-fips</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpqc-fips</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>crypto-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>crypto-api</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- cross tests with crypto-be-jdk -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>crypto-be-jdk</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- crypto-be-jdk: ML-DSA with context string, and the expanded ML-DSA / ML-KEM private keys
               from the seed, use the internals of the JDK -->
          <argLine>--add-exports java.base/sun.security.provider=ALL-UNNAMED --add-exports java.base/com.sun.crypto.provider=ALL-UNNAMED</argLine>
          <!-- false: overridden by CryptoBcFips, which sets the approved-only mode itself -->
          <systemPropertyVariables>
            <org.bouncycastle.fips.approved_only>false</org.bouncycastle.fips.approved_only>
          </systemPropertyVariables>
          <excludes combine.children="append">
            <exclude>**/UsedBeforeTest.java</exclude>
          </excludes>
        </configuration>
        <executions>
          <!-- runs in its own JVM: BC-FIPS is used before the backend, the backend is rejected -->
          <execution>
            <id>used-before</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <excludes combine.self="override"/>
              <includes>
                <include>**/UsedBeforeTest.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
